# Copier ce fichier vers .env (backend/.env) puis adapter les valeurs si besoin.
# .env n'est pas versionne : chaque environnement (dev, CI, prod) a le sien.

DB_USER=etudiant_db
DB_PASSWORD=etudiant_db
DB_HOST=localhost
DB_PORT=3306
DB_NAME=etudiant_db

# Cle de signature des JWT : generer une valeur aleatoire, par exemple avec `openssl rand -hex 32`.
# Ne jamais reutiliser une valeur d'exemple en production.
JWT_SECRET=change-me
JWT_EXPIRATION_MS=3600000
